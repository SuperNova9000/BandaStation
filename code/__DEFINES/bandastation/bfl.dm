/// BFL — Beam Freight Laser / «Большой Фокусирующий Лазер»
///
/// Установка по продаже электроэнергии станцией Центральному командованию.
/// Потребляет мощность из энергосети, копит тепло в ядре, требует газового
/// охлаждения. При перегреве — катастрофа со станционным ЭМИ.
///
/// Сама установка реализована модулем modular_bandastation/bfl, а константы
/// лежат здесь, потому что от них зависят и код модуля, и юнит-тесты:
/// code/modules/unit_tests подключается раньше модулей, а #define в DM
/// действует только вперёд по тексту.
///
/// Все числовые параметры собраны здесь, чтобы их можно было откалибровать
/// на сервере в одном месте.

// ---------------------------------------------------------------------------
// Режимы работы
// ---------------------------------------------------------------------------

/// Полностью обесточенная установка.
#define BFL_MODE_OFF 0
/// Минимальный рабочий режим.
#define BFL_MODE_MIN 1
/// Максимальный рабочий режим.
#define BFL_MODE_MAX 5

/// Номера рабочих режимов.
#define BFL_MODE_1 1
#define BFL_MODE_2 2
#define BFL_MODE_3 3
#define BFL_MODE_4 4
#define BFL_MODE_5 5

// ---------------------------------------------------------------------------
// Мощность потребления по режимам (ватты)
// ---------------------------------------------------------------------------

#define BFL_MODE_POWER_1 (500 KILO WATTS)
#define BFL_MODE_POWER_2 (1 MEGA WATTS)
#define BFL_MODE_POWER_3 (2 MEGA WATTS)
#define BFL_MODE_POWER_4 (4 MEGA WATTS)
#define BFL_MODE_POWER_5 (8 MEGA WATTS)

// ---------------------------------------------------------------------------
// КПД по режимам — доля отобранной энергии, дошедшая до ретранслятора.
// Остальное оседает теплом в ядре.
// ---------------------------------------------------------------------------

#define BFL_MODE_EFFICIENCY_1 0.90
#define BFL_MODE_EFFICIENCY_2 0.85
#define BFL_MODE_EFFICIENCY_3 0.80
#define BFL_MODE_EFFICIENCY_4 0.70
#define BFL_MODE_EFFICIENCY_5 0.60

// ---------------------------------------------------------------------------
// Тариф — кредитов за переданный мегаджоуль
// ---------------------------------------------------------------------------

#define BFL_TARIFF_1 0.4
#define BFL_TARIFF_2 0.6
#define BFL_TARIFF_3 0.9
#define BFL_TARIFF_4 1.3
#define BFL_TARIFF_5 2.0

// ---------------------------------------------------------------------------
// Тепловая модель
// ---------------------------------------------------------------------------

/// Температура ядра в холодном состоянии (К).
#define BFL_TEMP_BASE 300
/// Температура, при которой включается предупреждение (К).
#define BFL_TEMP_WARNING 800
/// Температура, при которой срабатывает аварийный сброс SCRAM (К).
#define BFL_TEMP_CRITICAL 1200
/// Температура, при которой происходит катастрофа (К).
#define BFL_TEMP_MELTDOWN 1500

/// Теплоёмкость ядра (Дж/К). Чем больше — тем больше энергии нужно набрать,
/// чтобы разогреть установку, и тем больше времени есть у инженера на реакцию.
#define BFL_CORE_HEAT_CAPACITY (400 * 1000)

/// Доля разницы температур между ядром и контуром, снимаемая за секунду.
/// 0.5 — контур стремится к температуре ядра, отдавая тепло.
#define BFL_COOLANT_RATE 0.5

/// Максимум мощности, который контур способен забрать из ядра (Вт).
/// Страховка от гигантских контуров и от подключения к вакууму.
#define BFL_COOLANT_MAX_TRANSFER (20 * 1000 * 1000)

/// Порог, после которого тариф начинает деградировать («ЦК насытилось»).
#define BFL_TARIFF_DECAY_THRESHOLD (50 MEGA JOULES)

/// Множитель тарифа после срабатывания деградации.
#define BFL_TARIFF_DECAY_FACTOR 0.5

// ---------------------------------------------------------------------------
// Энергосистема
// ---------------------------------------------------------------------------

/// Максимальная доля свободной мощности в сети, которую BFL может забрать.
/// Защищает станцию от «BFL вырубил APC всей станции».
#define BFL_MAX_GRID_SHARE 0.8

/// Порог просадки сети: если фактически получено меньше этой доли запрошенного
/// несколько тиков подряд — режим автоматически понижается.
#define BFL_GRID_SAG_THRESHOLD 0.9

/// Сколько тиков подряд должна держаться просадка, прежде чем режим снизится.
#define BFL_GRID_SAG_TICKS 3

// ---------------------------------------------------------------------------
// Состояния установки
// ---------------------------------------------------------------------------

#define BFL_STATE_OFFLINE 0
#define BFL_STATE_WARMUP 1
#define BFL_STATE_ONLINE 2
#define BFL_STATE_SCRAM 3
#define BFL_STATE_BROKEN 4

/// Время выхода на режим (разогрев ядра).
#define BFL_WARMUP_TIME (60 SECONDS)

/// Время остывания после аварийного сброса.
#define BFL_COOLDOWN_TIME (30 SECONDS)

// ---------------------------------------------------------------------------
// Повреждения
// ---------------------------------------------------------------------------

/// Максимальное накопленное повреждение. При достижении — катастрофа.
#define BFL_DAMAGE_MAX 100

/// Сколько повреждения набирается за превышение критической температуры.
#define BFL_DAMAGE_PER_TICK 0.5

/// Каждый процент повреждения снижает КПД на столько же процентных пунктов.
#define BFL_DAMAGE_EFFICIENCY_PENALTY 0.01

// ---------------------------------------------------------------------------
// Катастрофа
// ---------------------------------------------------------------------------

/// Радиус полного разрушения.
#define BFL_BLAST_DEVASTATION 3
/// Радиус тяжёлых повреждений.
#define BFL_BLAST_HEAVY 6
/// Радиус лёгких повреждений.
#define BFL_BLAST_LIGHT 12
/// Радиус ослепления.
#define BFL_BLAST_FLASH 20
